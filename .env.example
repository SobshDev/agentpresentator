# Copy to .env for development. Never commit real values (.env is gitignored).

# shared_router: base URL (no /v1) and a key issued to a dedicated "Website" person.
# Leave MODEL_API_KEY empty in development to get canned local answers.
MODEL_BASE_URL=https://router.example.com
MODEL_API_KEY=
MODEL_ID=claude-sonnet-4-6
MAX_OUTPUT_TOKENS=700

# Production only: set these in Dokploy, keep them commented out for local dev.
# SITE_ORIGIN must exactly match the address in the browser, or every request gets 403.
# SITE_ORIGIN=https://gabriel.example.com
# SESSION_SECRET=
# REDIS_URL=redis://redis:6379
# TRUSTED_PROXY_HOPS=1

# Optional bot protection (Cloudflare Turnstile, invisible mode)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limits (defaults shown)
LIMIT_SESSIONS_PER_IP_HOUR=12
LIMIT_MESSAGES_PER_SESSION_HOUR=30
LIMIT_MESSAGES_PER_IP_HOUR=40
LIMIT_MESSAGES_PER_IP_DAY=120
LIMIT_CONCURRENT_PER_IP=2
LIMIT_MESSAGES_PER_DAY=1500
LIMIT_TOKENS_PER_DAY=2000000
